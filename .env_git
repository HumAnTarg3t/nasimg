# Copy to .env and fill in. Both paths must be absolute, existing directories.
# Uploads land in original_file_path; the sorted library is new_file_path.
original_file_path = /mnt/sorting
new_file_path = /mnt/photos

# Optional — defaults shown:
# IANA timezone used to date videos (QuickTime dates are UTC); defaults to the machine's zone
#TZ_HOME = Europe/Oslo
# Log planned actions without moving anything
#DRY_RUN = 0
# Files modified more recently than this many minutes are left for the next run
#MIN_AGE_MINUTES = 10
# Parallel file operations
#CONCURRENCY = 2
